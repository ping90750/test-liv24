{
  "ConnectionStrings": {
    "Orders": "Data Source=orders.db"
  },
  "Pricing": {
    "BulkDiscountThreshold": 50000,
    "BulkDiscountAmount": 2000
  },
  "Outbox": {
    "Interval": "00:00:02",
    "BatchSize": 100,
    "MaxAttempts": 10
  },
  "Reconciliation": {
    "Interval": "00:01:00",
    "StaleAfter": "00:05:00",
    "BatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
